# Experiment 10: L2, Dropout and Early Stopping Comparison

import numpy as np
import tensorflow as tf
import matplotlib.pyplot as plt

from tensorflow.keras import Sequential
from tensorflow.keras.layers import Dense, Dropout
from tensorflow.keras.regularizers import l2

# 1. Generate dataset
np.random.seed(42)

X = np.random.rand(500, 10).astype("float32")

# Create labels based on input features
y = (X[:, 0] + X[:, 1] > 1).astype("float32")

# 2. Build neural network
model = Sequential([
    tf.keras.Input(shape=(10,)),
    Dense(32, activation="relu",
          kernel_regularizer=l2(0.01)),
    Dropout(0.5),
    Dense(16, activation="relu"),
    Dense(1, activation="sigmoid")
])

# 3. Compile model
model.compile(
    optimizer="adam",
    loss="binary_crossentropy",
    metrics=["accuracy"]
)

# 4. Configure early stopping
early_stop = tf.keras.callbacks.EarlyStopping(
    monitor="val_loss",
    patience=5,
    restore_best_weights=True
)

# 5. Train the model
history = model.fit(
    X, y,
    epochs=50,
    batch_size=32,
    validation_split=0.2,
    callbacks=[early_stop],
    verbose=1
)

# 6. Display final evaluation
loss, accuracy = model.evaluate(
    X, y, verbose=0
)

print("\nFinal Loss:", round(loss, 4))
print("Final Accuracy:", round(accuracy * 100, 2), "%")
print("Epochs Completed:", len(history.history["loss"]))

# 7. Plot training and validation loss
plt.figure(figsize=(8, 5))

plt.plot(
    history.history["loss"],
    label="Training Loss",
    marker="o"
)

plt.plot(
    history.history["val_loss"],
    label="Validation Loss",
    marker="o"
)

plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.title("Training vs Validation Loss")
plt.legend()
plt.grid(True)
plt.show()

# 8. Plot training and validation accuracy
plt.figure(figsize=(8, 5))

plt.plot(
    history.history["accuracy"],
    label="Training Accuracy",
    marker="o"
)

plt.plot(
    history.history["val_accuracy"],
    label="Validation Accuracy",
    marker="o"
)

plt.xlabel("Epoch")
plt.ylabel("Accuracy")
plt.title("Training vs Validation Accuracy")
plt.legend()
plt.grid(True)
plt.show()

# 9. Display model architecture
model.summary()
