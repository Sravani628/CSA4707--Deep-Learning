import numpy as np
import matplotlib.pyplot as plt

# Vectors
A = np.array([1, 2, 3])
B = np.array([4, 5, 6])

print("Vector Addition:", A + B)
print("Vector Dot Product:", np.dot(A, B))

# Matrices
M1 = np.array([[1, 2], [3, 4]])
M2 = np.array([[5, 6], [7, 8]])

print("\nMatrix Addition:")
print(M1 + M2)

print("\nMatrix Multiplication:")
print(M1 @ M2)

print("\nTranspose:")
print(M1.T)
